# Keep Railway/Nixpacks deploy contexts small and deterministic.
# Do not ship local QA artifacts, VCS data, virtualenvs, caches, or test outputs.
.git
.gitignore

.venv
.venv-*
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

artifacts/
evidence_packs/
screenshots/
tmp/
*.log

node_modules/
dist/
build/

# Local-only validation and research corpora; app runtime should not depend on them.
tests/
scripts/*e2e*
scripts/*replay*
marketing/
seo/
