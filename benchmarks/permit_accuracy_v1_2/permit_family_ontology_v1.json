  "anti_collapse_rules": [
    "ROOFING remains distinct from BUILDING when the source/runtime emits a roofing-specific typed label.",
    "OCCUPANCY_CO is not merged into ZONING_PLANNING.",
    "FIRE_LIFE_SAFETY is not merged into BUILDING.",
    "NO_PRIMARY_PERMIT is first-class and only valid as primary when the decision is NOT_REQUIRED.",
